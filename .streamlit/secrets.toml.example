# Copy to .streamlit/secrets.toml for local runs (git-ignored), or paste the same
# contents into Streamlit Community Cloud: App settings -> Secrets.

# Hosted Postgres (e.g. a Neon connection string). Leave it out locally to use recipes.db (SQLite).
# Streamlit Cloud wipes the app's disk on every restart, so DATABASE_URL is required there.
DATABASE_URL = "postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google sign-in, used by st.login(). Create a "Web application" OAuth client in
# Google Cloud Console -> APIs & Services -> Credentials and add redirect_uri below to it.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"  # on Cloud: https://<your-app>.streamlit.app/oauth2callback
cookie_secret = "a-long-random-string"  # e.g. python -c "import secrets; print(secrets.token_hex(32))"
client_id = "1234567890-example.apps.googleusercontent.com"
client_secret = "GOCSPX-example"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
